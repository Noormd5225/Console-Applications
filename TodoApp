class Task:
    
    def __init__(self,taskId,title,description,priority,status):
        self.taskId=taskId
        self.title=title
        self.description=description
        self.priority=priority
        self.status=status

    def display(self):
        print( self.taskId, " ",self.title," ",self.description," ",self.priority," ",self.status)

class TaskManagement:

    def __init__(self):
        self.task=[]
    

    def addTask(self,id,title,description,priority,status):
        t=Task(id,title,description,priority,status)
        self.task.append(t)

    def displayTask(self):
        if not self.task:
            print("No Task Found..")
            return
        for temp in self.task:
            temp.display()

    def displayPendingTask(self):
        if not self.task:
            print("No Task Found..")
            return
        for temp in self.task:
            if temp.status=='pending':
                 temp.display()

    def displayhighPriorityandPendingTask(self):
        if not self.task:
            print("No Task Found..")
            return
        for temp in self.task:
            if temp.priority=='high' and temp.status=='pending':
                 temp.display()


    def SearchByTask(self,id):
        if not self.task:
            print("No Task Found..")
            return
        for temp in self.task:
            if temp.id==id:
                 temp.display()

    def SearchByTaskName(self,title):
        if not self.task:
            print("No Task Found..")
            return
        for temp in self.task:
            if temp.title==title:
                 temp.display()


